# Supply these through a private environment. Local defaults need no credentials.
NALA_MODE=local
NALA_MAIL_MODE=file
# NALA_DATA_DIR=/private/nalanetra-data
# DATABASE_URL=postgresql+psycopg://user:password@localhost/nalanetra
# NALA_JWT_SECRET=generate-a-private-random-secret-of-at-least-32-characters
# NALA_CORS_ORIGINS=https://your-own-app-origin
# NALA_OSRM_URL=http://operator-managed-osrm:5000
# NALA_YOLO_WEIGHTS=/private/evaluated-weights.pt
# GOOGLE_APPLICATION_CREDENTIALS=/private/firebase-service-account.json
# Deployment requires NALA_MAIL_MODE=smtp and all four SMTP values:
# NALA_SMTP_HOST=mail.example.test
# NALA_SMTP_USER=operator-issued-account
# NALA_SMTP_PASSWORD=private-value
# NALA_SMTP_FROM=verified-sender@example.test
